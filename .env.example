# ============================================================
#  Copia este archivo a ".env" y completa los valores.
#  El archivo .env NO se sube al repositorio (ver .gitignore).
# ============================================================

# Proveedor activo: "openai", "anthropic" o "kimi"
LLM_PROVIDER=openai

# Solo necesitas la API key del proveedor elegido arriba.
# OpenAI:     https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic:  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Kimi (Moonshot AI): https://platform.kimi.ai/console/api-keys
KIMI_API_KEY=

# Modelo (opcional). Si lo dejas vacío se usa un sugerido:
#   openai    -> gpt-4o-mini
#   anthropic -> claude-haiku-4-5
#   kimi      -> kimi-k2.6
LLM_MODEL=

# Hiperparámetros (opcional)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
